# Copy to .env.local and adjust. Read by Next.js (packages/app) and the MikroORM CLI (packages/db).
DATABASE_URL=postgresql://gomoku:gomoku@localhost:5432/gomoku
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_DEBUG=false

# Proxy and origin (see .ai/specs/implemented/2026-10-24-account-registration.md). In production the first
# two are required; without them domain routes answer 500 (fail closed), /api/health still works.
# TRUST_PROXY_HOPS=1                 # number of our own proxies in front of the app (integer >= 1)
# CLIENT_IP_HEADER=x-forwarded-for   # or x-real-ip, cf-connecting-ip
# APP_ORIGIN=https://gomoku.byst.re  # exact origin of the app
# SESSION_COOKIE_SECURE=false        # integration tests only; not allowed with an https APP_ORIGIN
# PASSWORD_HASH_COST=12              # bcrypt cost, integer 4-31; lowered (4) only by the integration tests

# Outgoing mail (see .ai/specs/implemented/2026-10-24-email-verification.md and 2026-10-24-email-provider.md).
# Without EMAIL_TRANSPORT sending fails with 502 EMAIL_SEND_FAILED (accounts and games still work).
# EMAIL_TRANSPORT=file               # dev/tests: append messages as JSON lines to EMAIL_OUTBOX_PATH; in production only with an http:// APP_ORIGIN
# EMAIL_TRANSPORT=brevo              # production (#38): Brevo transactional API over HTTPS; needs the next two variables
# BREVO_API_KEY=                     # Brevo API key limited to transactional mail (secret: server env only, never commit)
# EMAIL_FROM_ADDRESS=                # sender address verified in Brevo (brevo transport)
# EMAIL_OUTBOX_PATH=.email-outbox.jsonl  # outbox file (git-ignored; holds full messages with links)
# EMAIL_FROM_NAME=Gomoku             # sender name shown in messages (EMAIL_FROM is the older alias)
# EMAIL_DAILY_LIMIT=100              # global daily send limit (positive integer); Brevo Free (300 a day): at most 176 (see README)
