# Copy to .env.production on the server and fill in. Never commit the real file (.gitignore).
# Used by: docker compose --env-file .env.production -f compose.prod.yaml up -d --build
# Generate the password with: openssl rand -hex 24   (hex keeps it safe inside DATABASE_URL)
POSTGRES_PASSWORD=
# Port of the app on the host; the mikr.us subdomain points to it (`domena gomoku.byst.re 3000`).
APP_PORT=3000
DATABASE_POOL_MAX=5
