# Copy to .env.production on the server and fill in. Never commit the real file (.gitignore).
# Used by: docker compose --env-file .env.production -f compose.prod.yaml up -d --build
# Generate the password with: openssl rand -hex 24   (hex keeps it safe inside DATABASE_URL)
POSTGRES_PASSWORD=
# Port of the app on the host; the mikr.us subdomain points to it (`domena gomoku.byst.re 3000`).
APP_PORT=3000
DATABASE_POOL_MAX=5
# Exact origin of the app (the mikr.us subdomain). Required: it is compared with the Origin header (CSRF).
# Fill in deliberately, e.g. https://gomoku.byst.re (compose refuses to start while empty).
APP_ORIGIN=
# Number of our own proxies in front of the app (integer >= 1). Required: the client address for the rate limit
# is the n-th entry from the right of CLIENT_IP_HEADER. A wrong value lets clients spoof their address or
# puts everybody under the proxy's address; verify it on the server (README.md).
# Fill in deliberately (e.g. 1 behind a single proxy); compose refuses to start while empty.
TRUST_PROXY_HOPS=
# Header with the client address: x-forwarded-for (default), x-real-ip or cf-connecting-ip (Cloudflare).
CLIENT_IP_HEADER=x-forwarded-for
# Set to 1 when the image is built on a small VPS (2 GB RAM, one core; mikr.us): the build then uses one Next
# worker and checks the types in a separate step, which avoids "Failed to type check" / SIGTERM from lack of memory.
LOW_MEMORY=0
