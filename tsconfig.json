{
  // Root-level TypeScript outside the packages: test configs, integration tests and the
  // `npm run setup` installer (plain ESM JavaScript, type-checked through JSDoc).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true
  },
  "include": ["vitest.config.ts", "vitest.integration.config.ts", "tests", "scripts/setup"]
}
